<script>

/* =========================
   TETRIS SETTINGS
========================= */

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const nextCanvas = document.getElementById("next");
const nextCtx = nextCanvas.getContext("2d");

const COLS = 10;
const ROWS = 20;
const BLOCK = 30;

const COLORS = [
    "",
    "#00ffff",
    "#0000ff",
    "#ff7f00",
    "#ffff00",
    "#00ff00",
    "#8000ff",
    "#ff0000"
];


/* =========================
   TETRIS PIECES
========================= */

const PIECES = [

    [
        [1,1,1,1]
    ],

    [
        [2,0,0],
        [2,2,2]
    ],

    [
        [0,0,3],
        [3,3,3]
    ],

    [
        [4,4],
        [4,4]
    ],

    [
        [0,5,5],
        [5,5,0]
    ],

    [
        [0,6,0],
        [6,6,6]
    ],

    [
        [7,7,0],
        [0,7,7]
    ]
];


/* =========================
   GAME VARIABLES
========================= */

let board;
let player;
let nextPiece;

let score = 0;
let lines = 0;
let level = 1;

let highScore =
    Number(localStorage.getItem("tetrisHighScore")) || 0;

let paused = false;
let gameOver = false;

let dropCounter = 0;
let lastTime = 0;

let dropSpeed = 700;


/* =========================
   CREATE BOARD
========================= */

function createBoard() {

    const newBoard = [];

    for (let y = 0; y < ROWS; y++) {
        newBoard.push(new Array(COLS).fill(0));
    }

    return newBoard;
}


/* =========================
   CREATE RANDOM PIECE
========================= */

function createPiece() {

    const index =
        Math.floor(Math.random() * PIECES.length);

    const shape =
        PIECES[index].map(row => row.slice());

    return {
        matrix: shape,
        x: Math.floor(
            (COLS - shape[0].length) / 2
        ),
        y: 0
    };
}


/* =========================
   COLLISION CHECK
========================= */

function collision(piece) {

    for (let y = 0; y < piece.matrix.length; y++) {

        for (let x = 0; x < piece.matrix[y].length; x++) {

            if (piece.matrix[y][x] === 0) {
                continue;
            }

            const newX = piece.x + x;
            const newY = piece.y + y;

            if (newX < 0 || newX >= COLS) {
                return true;
            }

            if (newY >= ROWS) {
                return true;
            }

            if (
                newY >= 0 &&
                board[newY][newX] !== 0
            ) {
                return true;
            }
        }
    }

    return false;
}


/* =========================
   MERGE PIECE
========================= */

function mergePiece() {

    for (let y = 0; y < player.matrix.length; y++) {

        for (let x = 0; x < player.matrix[y].length; x++) {

            const value = player.matrix[y][x];

            if (value !== 0) {

                const boardY = player.y + y;
                const boardX = player.x + x;

                if (
                    boardY >= 0 &&
                    boardY < ROWS &&
                    boardX >= 0 &&
                    boardX < COLS
                ) {
                    board[boardY][boardX] = value;
                }
            }
        }
    }
}


/* =========================
   CLEAR LINES
========================= */

function clearLines() {

    let cleared = 0;

    for (let y = ROWS - 1; y >= 0; y--) {

        let complete = true;

        for (let x = 0; x < COLS; x++) {

            if (board[y][x] === 0) {
                complete = false;
                break;
            }
        }

        if (complete) {

            board.splice(y, 1);

            board.unshift(
                new Array(COLS).fill(0)
            );

            cleared++;

            y++;
        }
    }

    if (cleared > 0) {

        lines += cleared;

        const points = [
            0,
            100,
            300,
            500,
            800
        ];

        score += points[cleared] * level;

        level =
            Math.floor(lines / 10) + 1;

        dropSpeed =
            Math.max(
                100,
                700 - (level - 1) * 60
            );
    }
}


/* =========================
   LOCK PIECE
========================= */

function lockPiece() {

    mergePiece();

    clearLines();

    player = nextPiece;
    nextPiece = createPiece();

    player.x =
        Math.floor(
            (COLS - player.matrix[0].length) / 2
        );

    player.y = 0;

    if (collision(player)) {

        gameOver = true;

        document.getElementById("message")
            .textContent =
            "GAME OVER! Press R to restart.";
    }

    updateScore();
}


/* =========================
   MOVE LEFT
========================= */

function moveLeft() {

    if (paused || gameOver) return;

    player.x--;

    if (collision(player)) {
        player.x++;
    }
}


/* =========================
   MOVE RIGHT
========================= */

function moveRight() {

    if (paused || gameOver) return;

    player.x++;

    if (collision(player)) {
        player.x--;
    }
}


/* =========================
   MOVE DOWN
========================= */

function moveDown() {

    if (paused || gameOver) return;

    player.y++;

    if (collision(player)) {

        player.y--;

        lockPiece();
    }

    dropCounter = 0;
}


/* =========================
   HARD DROP
========================= */

function hardDrop() {

    if (paused || gameOver) return;

    let distance = 0;

    while (true) {

        player.y++;

        if (collision(player)) {

            player.y--;

            break;
        }

        distance++;
    }

    score += distance * 2;

    lockPiece();

    updateScore();

    dropCounter = 0;
}


/* =========================
   ROTATE
========================= */

function rotateMatrix(matrix) {

    const result = [];

    for (
        let x = 0;
        x < matrix[0].length;
        x++
    ) {

        const row = [];

        for (
            let y = matrix.length - 1;
            y >= 0;
            y--
        ) {

            row.push(matrix[y][x]);
        }

        result.push(row);
    }

    return result;
}


function rotatePiece() {

    if (paused || gameOver) return;

    const oldMatrix = player.matrix;
    const oldX = player.x;

    player.matrix =
        rotateMatrix(player.matrix);

    if (collision(player)) {

        player.x++;

        if (collision(player)) {

            player.x = oldX - 1;

            if (collision(player)) {

                player.matrix = oldMatrix;
                player.x = oldX;
            }
        }
    }
}


/* =========================
   DRAW BLOCK
========================= */

function drawBlock(
    context,
    x,
    y,
    size,
    color
) {

    context.fillStyle = color;

    context.fillRect(
        x,
        y,
        size,
        size
    );

    context.strokeStyle =
        "rgba(255,255,255,0.25)";

    context.strokeRect(
        x,
        y,
        size,
        size
    );

    context.fillStyle =
        "rgba(255,255,255,0.18)";

    context.fillRect(
        x + 3,
        y + 3,
        size - 6,
        5
    );
}


/* =========================
   DRAW BOARD
========================= */

function drawBoard() {

    ctx.fillStyle = "#020617";

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    for (let y = 0; y < ROWS; y++) {

        for (let x = 0; x < COLS; x++) {

            const value = board[y][x];

            if (value !== 0) {

                drawBlock(
                    ctx,
                    x * BLOCK,
                    y * BLOCK,
                    BLOCK,
                    COLORS[value]
                );
            }
        }
    }

    /* Grid */

    ctx.strokeStyle =
        "rgba(255,255,255,0.05)";

    for (let x = 0; x <= COLS; x++) {

        ctx.beginPath();

        ctx.moveTo(
            x * BLOCK,
            0
        );

        ctx.lineTo(
            x * BLOCK,
            canvas.height
        );

        ctx.stroke();
    }

    for (let y = 0; y <= ROWS; y++) {

        ctx.beginPath();

        ctx.moveTo(
            0,
            y * BLOCK
        );

        ctx.lineTo(
            canvas.width,
            y * BLOCK
        );

        ctx.stroke();
    }
}


/* =========================
   DRAW PLAYER
========================= */

function drawPlayer() {

    if (!player) return;

    for (
        let y = 0;
        y < player.matrix.length;
        y++
    ) {

        for (
            let x = 0;
            x < player.matrix[y].length;
            x++
        ) {

            const value =
                player.matrix[y][x];

            if (value !== 0) {

                drawBlock(
                    ctx,
                    (player.x + x) * BLOCK,
                    (player.y + y) * BLOCK,
                    BLOCK,
                    COLORS[value]
                );
            }
        }
    }
}


/* =========================
   DRAW NEXT PIECE
========================= */

function drawNext() {

    nextCtx.fillStyle = "#020617";

    nextCtx.fillRect(
        0,
        0,
        nextCanvas.width,
        nextCanvas.height
    );

    if (!nextPiece) return;

    const size = 24;

    const width =
        nextPiece.matrix[0].length * size;

    const height =
        nextPiece.matrix.length * size;

    const startX =
        (120 - width) / 2;

    const startY =
        (120 - height) / 2;

    for (
        let y = 0;
        y < nextPiece.matrix.length;
        y++
    ) {

        for (
            let x = 0;
            x < nextPiece.matrix[y].length;
            x++
        ) {

            const value =
                nextPiece.matrix[y][x];

            if (value !== 0) {

                drawBlock(
                    nextCtx,
                    startX + x * size,
                    startY + y * size,
                    size,
                    COLORS[value]
                );
            }
        }
    }
}


/* =========================
   DRAW GAME
========================= */

function draw() {

    drawBoard();
    drawPlayer();
    drawNext();
}


/* =========================
   UPDATE SCORE
========================= */

function updateScore() {

    if (score > highScore) {

        highScore = score;

        localStorage.setItem(
            "tetrisHighScore",
            highScore
        );
    }

    document.getElementById("score")
        .textContent = score;

    document.getElementById("lines")
        .textContent = lines;

    document.getElementById("level")
        .textContent = level;

    document.getElementById("highScore")
        .textContent = highScore;
}


/* =========================
   PAUSE
========================= */

function pauseGame() {

    if (gameOver) return;

    paused = !paused;

    document.getElementById("message")
        .textContent =
        paused ? "GAME PAUSED" : "";
}


/* =========================
   RESTART
========================= */

function restartGame() {

    board = createBoard();

    player = createPiece();

    nextPiece = createPiece();

    score = 0;
    lines = 0;
    level = 1;

    dropSpeed = 700;

    paused = false;
    gameOver = false;

    dropCounter = 0;

    document.getElementById("message")
        .textContent = "";

    updateScore();

    draw();
}


/* =========================
   KEYBOARD
========================= */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key === "ArrowLeft" ||
            event.key === "ArrowRight" ||
            event.key === "ArrowDown" ||
            event.key === "ArrowUp" ||
            event.key === " "
        ) {
            event.preventDefault();
        }

        if (event.key === "ArrowLeft") {
            moveLeft();
        }

        else if (event.key === "ArrowRight") {
            moveRight();
        }

        else if (event.key === "ArrowDown") {
            moveDown();
        }

        else if (event.key === "ArrowUp") {
            rotatePiece();
        }

        else if (event.key === " ") {
            hardDrop();
        }

        else if (
            event.key === "p" ||
            event.key === "P"
        ) {
            pauseGame();
        }

        else if (
            event.key === "r" ||
            event.key === "R"
        ) {
            restartGame();
        }
    }
);


/* =========================
   GAME LOOP
========================= */

function gameLoop(time) {

    const delta =
        time - lastTime;

    lastTime = time;

    if (!paused && !gameOver) {

        dropCounter += delta;

        if (dropCounter > dropSpeed) {

            moveDown();
        }
    }

    draw();

    requestAnimationFrame(gameLoop);
}


/* =========================
   START
========================= */

restartGame();

requestAnimationFrame(gameLoop);

</script>

</body>
</html>
